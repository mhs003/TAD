#!/data/data/com.termux/files/usr/bin/bash
# tad-setup — build the complete on-device Android toolchain from an empty Termux.
#
# Installs exclusively from: Termux packages, Google's Android SDK
# (dl.google.com), and Gradle's official distribution.
set -euo pipefail

_self="$(readlink -f "$0" 2>/dev/null || echo "$0")"
TAD_ROOT="$(cd "$(dirname "$_self")/.." && pwd)"; export TAD_ROOT
# shellcheck source=lib/common.sh
. "$TAD_ROOT/lib/common.sh"
load_conf

in_termux || die "this toolchain targets Termux and must run inside it"

printf '\n%s%s%s\n' "$_b" "TAD — Termux Android Dev" "$_r"
printf '  %s\n\n' "Installing the on-device toolchain. Safe to re-run at any time."

# Report failures plainly; every step is safe to re-run.
on_error() {
  local code=$?
  [ "$code" -ne 0 ] && err "tad-setup stopped (exit $code). Every step is idempotent — fix the cause and re-run."
  exit "$code"
}
trap on_error ERR

# ---------------------------------------------------------------------------
# 1. Termux packages
# ---------------------------------------------------------------------------
step "Updating Termux package lists"
pkg update -y >/dev/null 2>&1 || warn "pkg update reported issues; continuing"

step "Installing Termux packages"
PKGS=(openjdk-"$JAVA_MAJOR" gradle kotlin aapt2 apksigner d8 android-tools wget unzip git)
info "${PKGS[*]}"
pkg install -y "${PKGS[@]}"

load_env
ok "java:    $(java -version 2>&1 | head -n1)"
ok "aapt2:   $PREFIX/bin/aapt2"
ok "adb:     $(adb version 2>&1 | head -n1)"

[ -x "$PREFIX/bin/aapt2" ] || die "Termux aapt2 not found — required to replace the x86-64 SDK aapt2"

# ---------------------------------------------------------------------------
# 2. Android SDK command-line tools (Google)
# ---------------------------------------------------------------------------
SDKMGR="$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager"
if [ -x "$SDKMGR" ]; then
  ok "sdkmanager already present"
else
  step "Downloading Android SDK command-line tools (build $CMDLINE_TOOLS_BUILD)"
  url="https://dl.google.com/android/repository/commandlinetools-linux-${CMDLINE_TOOLS_BUILD}_latest.zip"
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  wget -q --show-progress --tries=3 --timeout=60 -O "$tmp/clt.zip" "$url" || die "download failed: $url"
  unzip -q "$tmp/clt.zip" -d "$tmp"
  mkdir -p "$ANDROID_HOME/cmdline-tools"
  rm -rf "$ANDROID_HOME/cmdline-tools/latest"
  mv "$tmp/cmdline-tools" "$ANDROID_HOME/cmdline-tools/latest"
  rm -rf "$tmp"; trap - EXIT
  ok "installed: cmdline-tools/latest"
fi

export PATH="$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:$PATH"

# ---------------------------------------------------------------------------
# 3. SDK components (Google) + licenses
# ---------------------------------------------------------------------------
step "Accepting Android SDK licenses"
yes 2>/dev/null | sdkmanager --sdk_root="$ANDROID_HOME" --licenses >/dev/null 2>&1 || true

step "Installing SDK components"
info "platform-tools · platforms;android-$SDK_PLATFORM · build-tools;$BUILD_TOOLS"
sdkmanager --sdk_root="$ANDROID_HOME" \
  "platform-tools" \
  "platforms;android-$SDK_PLATFORM" \
  "build-tools;$BUILD_TOOLS"
ok "SDK components installed"

# AGP's connected tests invoke $ANDROID_HOME/platform-tools/adb, which is an
# x86-64 binary. Point it at Termux's aarch64 adb instead of a third-party tool.
PT_ADB="$ANDROID_HOME/platform-tools/adb"
if [ -x "$PREFIX/bin/adb" ] && [ ! -L "$PT_ADB" ]; then
  if [ -e "$PT_ADB" ]; then mv -f "$PT_ADB" "$PT_ADB.orig" 2>/dev/null || true; fi
  ln -sf "$PREFIX/bin/adb" "$PT_ADB" && ok "platform-tools/adb -> Termux aarch64 adb"
fi

# ---------------------------------------------------------------------------
# 4. Environment file + shell integration
# ---------------------------------------------------------------------------
step "Writing $TAD_ENV"
cat > "$TAD_ENV" <<EOF
# Generated by tad-setup — do not edit by hand; re-run tad-setup.
export ANDROID_HOME="$ANDROID_HOME"
export ANDROID_SDK_ROOT="$ANDROID_HOME"
export JAVA_HOME="$JAVA_HOME"
export PATH="\$JAVA_HOME/bin:\$ANDROID_HOME/cmdline-tools/latest/bin:$PREFIX/bin:\$PATH"
EOF
ok "env.sh written"

RC="$HOME/.bashrc"
MARK_BEGIN="# >>> TAD >>>"
MARK_END="# <<< TAD <<<"
if grep -qF "$MARK_BEGIN" "$RC" 2>/dev/null; then
  ok "~/.bashrc already sourced"
else
  step "Adding source hook to ~/.bashrc"
  {
    printf '\n%s\n' "$MARK_BEGIN"
    printf '[ -f "%s" ] && . "%s"\n' "$TAD_ENV" "$TAD_ENV"
    printf '%s\n' "$MARK_END"
  } >> "$RC"
  ok "added to ~/.bashrc"
fi

# ---------------------------------------------------------------------------
# 5. Gradle configuration (aapt2 override + on-device stability)
# ---------------------------------------------------------------------------
step "Configuring ~/.gradle/gradle.properties"
GP="$HOME/.gradle/gradle.properties"
mkdir -p "$HOME/.gradle"
touch "$GP"
set_gp() { # key value
  local k="$1" v="$2"
  if grep -q "^${k}=" "$GP" 2>/dev/null; then
    # use a delimiter unlikely to appear in values
    sed -i "s|^${k}=.*|${k}=${v}|" "$GP"
  else
    printf '%s=%s\n' "$k" "$v" >> "$GP"
  fi
}
set_gp android.aapt2FromMavenOverride "$PREFIX/bin/aapt2"
set_gp org.gradle.daemon "false"
set_gp org.gradle.parallel "false"
set_gp org.gradle.jvmargs "$GRADLE_JVMARGS"
set_gp org.gradle.java.installations.auto-download "false"
ok "aapt2 override -> $PREFIX/bin/aapt2"

# ---------------------------------------------------------------------------
# 6. Gradle + Kotlin (Termux packages)
# ---------------------------------------------------------------------------
step "Checking Gradle and Kotlin"
if command -v gradle >/dev/null 2>&1; then
  ok "gradle: $(gradle --version 2>/dev/null | sed -n 's/^Gradle //p' | head -n1)"
else
  warn "Termux 'gradle' package not on PATH — install with: pkg install gradle"
fi
if command -v kotlinc >/dev/null 2>&1; then
  ok "kotlinc: $(kotlinc -version 2>&1 | grep -o 'kotlinc-jvm [0-9.]*' | head -n1)"
else
  warn "Termux 'kotlin' package not on PATH — install with: pkg install kotlin"
fi

# ---------------------------------------------------------------------------
# 7. Verify
# ---------------------------------------------------------------------------
printf '\n'
step "Verification"
"$TAD_BIN/tad-doctor" || true

printf '\n'
ok "Setup complete."
info "Open a new shell (or: source ~/.bashrc), then try: tad-new MyApp && cd MyApp && tad-run"
