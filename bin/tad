#!/data/data/com.termux/files/usr/bin/bash
# tad — dispatch to the tad-* commands.
set -euo pipefail

_self="$(readlink -f "$0" 2>/dev/null || echo "$0")"
TAD_ROOT="$(cd "$(dirname "$_self")/.." && pwd)"
# shellcheck source=../lib/common.sh
. "$TAD_ROOT/lib/common.sh"

usage() {
  printf '%s%s%s\n' "$_b" "TAD — Termux Android Dev" "$_r"
  printf '  %s\n' "Build, install and test Kotlin + Compose apps on-device, in Termux."
  printf '\n  %sUsage:%s tad <command> [args]\n' "$_b" "$_r"

  group "Toolchain"
  cmdrow setup   "install the toolchain (JDK, Android SDK, build-tools)"
  cmdrow doctor  "check the toolchain and report problems"

  group "Project"
  cmdrow new     "new <name> [--package <id>] [--dir <path>]"
  cmdrow init    "init [dir] — make an existing project buildable"

  group "Build and run"
  cmdrow build   "build [debug|release] — assemble and verify an APK"
  cmdrow run     "run [--log] — build, install and launch"
  cmdrow install "install [apk] — install an APK on the device"
  cmdrow test    "test [unit|instrumented|all]"
  cmdrow clean   "clean [--daemon|--all]"

  group "Device"
  cmdrow adb     "adb <cmd> — pair, connect, devices, logcat, …"

  printf '\n  %sExamples%s\n' "$_b" "$_r"
  printf '    %s\n' "tad setup"
  printf '    %s\n' "tad new MyApp --package com.example.myapp"
  printf '    %s\n' "cd MyApp && tad run"
  printf '\n'
}

cmd="${1:-}"
case "$cmd" in
  ""|-h|--help|help) usage; exit 0 ;;
esac
shift || true

target="$TAD_ROOT/bin/tad-$cmd"
if [ ! -x "$target" ]; then
  err "unknown command: $cmd"
  printf '\n'
  usage
  exit 2
fi

exec "$target" "$@"
